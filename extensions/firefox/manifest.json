{
  "manifest_version": 2,
  "name": "Inspekt",
  "version": "1.0.0",
  "description": "Execute JavaScript in your browser from the command line. Works on all websites, bypasses CSP restrictions.",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "tabs",
    "activeTab",
    "<all_urls>",
    "storage"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["console-hooks.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/core/permissions.js",
        "shared/core/websocket-client.js",
        "shared/core/main-world-bridge.js",
        "shared/modules/hidden-elements.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Inspekt",
    "default_popup": "shared/popup/popup-base.html"
  },

  "web_accessible_resources": [
    "css/material-icons.css",
    "fonts/material-icons.woff2",
    "scripts/console-hooks-inject.js"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "inspekt@roelvangils.github.io",
      "strict_min_version": "109.0"
    }
  }
}
