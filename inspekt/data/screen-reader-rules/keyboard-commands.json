{
  "_meta": {
    "version": "1.0.0",
    "description": "Keyboard commands for each screen reader, organized by mode. The 'SR' modifier is configurable (defaults to CapsLock, replaces Insert).",
    "sources": [
      "https://github.com/w3c/aria-at/blob/master/tests/commands.json",
      "https://github.com/w3c/aria-at/blob/master/tests/support.json",
      "JAWS 2024 keyboard reference",
      "NVDA 2024.1 user guide",
      "VoiceOver macOS 15 commands reference"
    ],
    "modifier_note": "In the VM simulator, 'SR' (Insert) is replaced by a configurable modifier key (default: CapsLock). 'VO' (VoiceOver modifier) is Control+Option."
  },

  "jaws": {
    "_info": {
      "name": "JAWS",
      "full_name": "Job Access With Speech",
      "platform": "Windows",
      "modifier": "Insert",
      "modes": {
        "reading": "Virtual Cursor (reading mode) — navigate page content line by line",
        "interaction": "PC Cursor (forms/interaction mode) — interact with form controls and widgets"
      },
      "mode_switch": "JAWS auto-switches to interaction mode on form controls. Press Escape to return to reading mode."
    },
    "reading": {
      "_description": "Virtual cursor active — read and navigate page content",
      "navigation": {
        "ArrowDown":       { "action": "next-line", "label": "Next line" },
        "ArrowUp":         { "action": "previous-line", "label": "Previous line" },
        "ArrowRight":      { "action": "next-character", "label": "Next character" },
        "ArrowLeft":       { "action": "previous-character", "label": "Previous character" },
        "Tab":             { "action": "next-focusable", "label": "Next focusable element" },
