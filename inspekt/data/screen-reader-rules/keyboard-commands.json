        "6":               { "action": "next-heading-level", "level": 6, "label": "Next heading level 6" },
        "k":               { "action": "next-link", "label": "Next link" },
        "Shift+k":         { "action": "previous-link", "label": "Previous link" },
        "u":               { "action": "next-unvisited-link", "label": "Next unvisited link" },
        "v":               { "action": "next-visited-link", "label": "Next visited link" },
        "f":               { "action": "next-form-field", "label": "Next form field" },
        "Shift+f":         { "action": "previous-form-field", "label": "Previous form field" },
        "b":               { "action": "next-button", "label": "Next button" },
        "Shift+b":         { "action": "previous-button", "label": "Previous button" },
        "t":               { "action": "next-table", "label": "Next table" },
        "Shift+t":         { "action": "previous-table", "label": "Previous table" },
        "l":               { "action": "next-list", "label": "Next list" },
        "Shift+l":         { "action": "previous-list", "label": "Previous list" },
        "i":               { "action": "next-list-item", "label": "Next list item" },
        "Shift+i":         { "action": "previous-list-item", "label": "Previous list item" },
        "g":               { "action": "next-graphic", "label": "Next graphic" },
        "Shift+g":         { "action": "previous-graphic", "label": "Previous graphic" },
        "r":               { "action": "next-landmark", "label": "Next landmark" },
        "Shift+r":         { "action": "previous-landmark", "label": "Previous landmark" },
        "q":               { "action": "next-blockquote", "label": "Next blockquote" },
        "Shift+q":         { "action": "previous-blockquote", "label": "Previous blockquote" },
        "s":               { "action": "next-separator", "label": "Next separator" }
      },
      "actions": {
        "Enter":           { "action": "activate", "label": "Activate link/button" },
        "Space":           { "action": "activate", "label": "Activate element" },
        "SR+ArrowDown":    { "action": "say-all", "label": "Read from cursor to end" },
        "SR+ArrowUp":      { "action": "say-line", "label": "Read current line" },
        "Escape":          { "action": "stop-speech", "label": "Stop speech" }
      },
      "lists": {
        "SR+F5":           { "action": "list-form-fields", "label": "List form fields" },
        "SR+F6":           { "action": "list-headings", "label": "List headings" },
        "SR+F7":           { "action": "list-links", "label": "List links" },
        "SR+F9":           { "action": "list-frames", "label": "List frames" }
      }
    },
    "interaction": {
      "_description": "PC cursor active — interact with form controls and widgets",
      "navigation": {
        "Tab":             { "action": "next-focusable", "label": "Next focusable element" },
        "Shift+Tab":       { "action": "previous-focusable", "label": "Previous focusable element" },
        "ArrowDown":       { "action": "widget-next", "label": "Next option/item" },
        "ArrowUp":         { "action": "widget-previous", "label": "Previous option/item" },
        "ArrowRight":      { "action": "widget-right", "label": "Move right in widget" },
        "ArrowLeft":       { "action": "widget-left", "label": "Move left in widget" }
      },
      "actions": {
        "Enter":           { "action": "activate", "label": "Activate/submit" },
        "Space":           { "action": "toggle", "label": "Toggle checkbox/button" },
        "Escape":          { "action": "exit-to-reading", "label": "Return to reading mode" }
      }
    }
  },

