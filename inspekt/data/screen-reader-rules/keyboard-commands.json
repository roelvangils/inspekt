  "voiceover": {
    "_info": {
      "name": "VoiceOver",
      "full_name": "VoiceOver for macOS",
      "platform": "macOS",
      "modifier": "Control+Option (VO)",
      "modes": {
        "reading": "Standard navigation — VO+Arrow keys to move through content",
        "quick_nav": "Quick Nav (Left+Right arrows simultaneously to toggle) — arrow keys navigate without VO modifier",
        "interaction": "Interact mode (VO+Shift+Down) — navigate within complex widgets"
      },
      "mode_note": "VoiceOver doesn't have a traditional mode switch like JAWS/NVDA. Quick Nav changes arrow key behavior."
    },
    "reading": {
      "_description": "Standard VoiceOver navigation with VO modifier",
      "navigation": {
        "VO+ArrowRight":   { "action": "next-element", "label": "Next element" },
        "VO+ArrowLeft":    { "action": "previous-element", "label": "Previous element" },
        "VO+ArrowDown":    { "action": "next-line", "label": "Next line / Read next" },
        "VO+ArrowUp":      { "action": "previous-line", "label": "Previous line" },
        "Tab":             { "action": "next-focusable", "label": "Next focusable element" },
        "Shift+Tab":       { "action": "previous-focusable", "label": "Previous focusable element" },
        "VO+Home":         { "action": "top-of-page", "label": "Top of page" },
        "VO+End":          { "action": "bottom-of-page", "label": "Bottom of page" },
        "VO+Shift+ArrowDown": { "action": "interact-with", "label": "Interact with container" },
        "VO+Shift+ArrowUp":   { "action": "stop-interacting", "label": "Stop interacting with container" }
      },
      "quick_nav": {
        "VO+Cmd+h":        { "action": "next-heading", "label": "Next heading" },
        "VO+Cmd+Shift+h":  { "action": "previous-heading", "label": "Previous heading" },
        "VO+Cmd+l":        { "action": "next-link", "label": "Next link" },
        "VO+Cmd+Shift+l":  { "action": "previous-link", "label": "Previous link" },
        "VO+Cmd+j":        { "action": "next-form-field", "label": "Next form control" },
        "VO+Cmd+Shift+j":  { "action": "previous-form-field", "label": "Previous form control" },
        "VO+Cmd+t":        { "action": "next-table", "label": "Next table" },
        "VO+Cmd+Shift+t":  { "action": "previous-table", "label": "Previous table" },
        "VO+Cmd+x":        { "action": "next-list", "label": "Next list" },
        "VO+Cmd+Shift+x":  { "action": "previous-list", "label": "Previous list" },
        "VO+Cmd+g":        { "action": "next-graphic", "label": "Next graphic" },
        "VO+Cmd+Shift+g":  { "action": "previous-graphic", "label": "Previous graphic" }
      },
      "actions": {
        "VO+Space":        { "action": "activate", "label": "Activate element" },
        "VO+a":            { "action": "say-all", "label": "Read from cursor to end" },
        "Ctrl":            { "action": "stop-speech", "label": "Stop speech" },
        "VO+u":            { "action": "rotor", "label": "Open Rotor (headings, links, etc.)" },
        "VO+F3":           { "action": "item-description", "label": "Describe item" }
      }
    },
    "quick_nav_on": {
      "_description": "Quick Nav enabled — arrow keys navigate without VO modifier. Toggle with Left+Right arrows simultaneously.",
      "navigation": {
        "ArrowRight":      { "action": "next-element", "label": "Next element" },
        "ArrowLeft":       { "action": "previous-element", "label": "Previous element" },
        "ArrowDown":       { "action": "next-heading", "label": "Next heading (or Rotor item)" },
        "ArrowUp":         { "action": "previous-heading", "label": "Previous heading (or Rotor item)" }
      }
    }
  },

