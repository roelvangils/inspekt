{
  "_meta": {
    "version": "1.0.0",
    "description": "Verbosity levels control how much detail the simulator announces. Maps to real SR verbosity settings: JAWS (Beginner/Intermediate/Advanced), NVDA (verbosity settings), VoiceOver (verbosity level).",
    "default": "high"
  },

  "high": {
    "_description": "Beginner / maximum verbosity. Announces everything. Matches default settings for new SR users.",
    "announce_role": true,
    "announce_state": true,
    "announce_description": true,
    "announce_hints": true,
    "announce_position_in_set": true,
    "announce_landmarks_on_enter": true,
    "announce_landmarks_on_exit": true,
    "announce_list_item_count": true,
    "announce_list_item_bullet": true,
    "announce_table_dimensions": true,
    "announce_table_cell_coords": true,
    "announce_grouping": true,
    "announce_visited_link_status": true,
    "announce_required_state": true,
    "announce_invalid_state": true,
    "announce_readonly_state": true,
    "announce_disabled_state": true,
    "announce_aria_current": true,
    "announce_language_change": true,
    "announce_blank_fields": true
  },

  "medium": {
    "_description": "Intermediate verbosity. Announces role, state, and important context. Skips hints and some positional info.",
    "announce_role": true,
    "announce_state": true,
    "announce_description": true,
    "announce_hints": false,
    "announce_position_in_set": false,
    "announce_landmarks_on_enter": true,
    "announce_landmarks_on_exit": false,
    "announce_list_item_count": true,
    "announce_list_item_bullet": false,
    "announce_table_dimensions": true,
    "announce_table_cell_coords": true,
    "announce_grouping": true,
    "announce_visited_link_status": false,
    "announce_required_state": true,
    "announce_invalid_state": true,
    "announce_readonly_state": true,
    "announce_disabled_state": true,
    "announce_aria_current": true,
    "announce_language_change": true,
    "announce_blank_fields": false
  },

  "low": {
    "_description": "Expert / minimal verbosity. Announces role and name only. Minimal state. For experienced SR users.",
    "announce_role": true,
    "announce_state": true,
    "announce_description": false,
    "announce_hints": false,
    "announce_position_in_set": false,
    "announce_landmarks_on_enter": false,
    "announce_landmarks_on_exit": false,
    "announce_list_item_count": false,
    "announce_list_item_bullet": false,
    "announce_table_dimensions": false,
    "announce_table_cell_coords": false,
    "announce_grouping": false,
    "announce_visited_link_status": false,
    "announce_required_state": true,
    "announce_invalid_state": true,
    "announce_readonly_state": false,
    "announce_disabled_state": true,
    "announce_aria_current": true,
    "announce_language_change": false,
    "announce_blank_fields": false
  }
}
