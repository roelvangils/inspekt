{
  "_meta": {
    "version": "1.0.0",
    "description": "Screen reader announcement templates per ARIA role. Templates use {placeholders} for dynamic values.",
    "sources": [
      "https://github.com/accessibilitysupported/a11ysupport.io",
      "https://github.com/w3c/aria-at",
      "Manual curation from JAWS 2024, NVDA 2024.1, VoiceOver macOS 15"
    ],
    "screen_readers": ["jaws", "nvda", "voiceover"],
    "template_variables": {
      "{name}": "Computed accessible name (aria-label, aria-labelledby, or content)",
      "{description}": "aria-describedby or aria-description content",
      "{level}": "Heading level (1-6)",
      "{value}": "Current value (for form controls, sliders, etc.)",
      "{min}": "Minimum value (for range controls)",
      "{max}": "Maximum value (for range controls)",
      "{position}": "Position in set (aria-posinset)",
      "{setsize}": "Total items in set (aria-setsize)",
      "{rowcount}": "Number of rows in table/grid",
      "{colcount}": "Number of columns in table/grid",
      "{rowindex}": "Current row index",
      "{colindex}": "Current column index"
    }
  },

  "alert": {
    "jaws": {
      "enter": "Alert, {name}",
      "live_announce": "{name}"
    },
    "nvda": {
      "enter": "Alert, {name}",
      "live_announce": "Alert, {name}"
    },
    "voiceover": {
      "enter": "{name}, alert",
      "live_announce": "{name}"
    }
  },

  "alertdialog": {
    "jaws": {
      "enter": "Alert dialog, {name}"
    },
    "nvda": {
      "enter": "Alert dialog, {name}"
    },
    "voiceover": {
      "enter": "{name}, alert, dialog"
    }
  },

  "application": {
    "jaws": {
      "enter": "Application, {name}"
    },
    "nvda": {
      "enter": "Application, {name}"
    },
    "voiceover": {
      "enter": "{name}, application"
    }
  },

  "article": {
    "jaws": {
      "enter": "Article, {name}",
      "exit": "End of article"
    },
    "nvda": {
      "enter": "Article, {name}",
      "exit": "Out of article"
    },
    "voiceover": {
      "enter": "{name}, article"
