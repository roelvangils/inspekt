      "enter": "{name}, button"
    },
    "nvda": {
      "enter": "{name}, button"
    },
    "voiceover": {
      "enter": "{name}, button"
    }
  },

  "cell": {
    "jaws": {
      "enter": "{name}, column {colindex}, row {rowindex}"
    },
    "nvda": {
      "enter": "Column {colindex}, row {rowindex}, {name}"
    },
    "voiceover": {
      "enter": "Column {colindex}, row {rowindex}, {name}"
    }
  },

  "checkbox": {
    "jaws": {
      "enter": "{name}, checkbox, {state:checked}"
    },
    "nvda": {
      "enter": "{name}, checkbox, {state:checked}"
    },
    "voiceover": {
      "enter": "{name}, {state:checked}, tick box"
    },
    "_states": {
      "checked": {
        "true":  { "jaws": "checked", "nvda": "checked", "voiceover": "ticked" },
        "false": { "jaws": "not checked", "nvda": "not checked", "voiceover": "unticked" },
        "mixed": { "jaws": "partially checked", "nvda": "half checked", "voiceover": "mixed" }
      }
    }
  },

  "columnheader": {
    "jaws": {
