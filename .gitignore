# =====================================================================
# Inspekt root .gitignore — single source of truth for all subtrees.
# Keep paths anchored (/foo) when a rule should apply only at the
# repo root. Children (apps/, extensions/, vm/) inherit from here;
# child-level .gitignore files have been folded back into this one.
# =====================================================================

# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---------------------------------------------
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Node.js ----------------------------------------------------------
node_modules/
package-lock.json

# --- Rust / Tauri build artifacts -------------------------------------
target/
apps/*/dist/
apps/*/src-tauri/WixTools/
vm/dist/

# --- Browser extension build artifacts --------------------------------
extensions/firefox/web-ext-artifacts/

# --- Tests / coverage -------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml

# --- IDEs / editors ---------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS metadata ------------------------------------------------------
.DS_Store
Thumbs.db

# --- Environment / secrets --------------------------------------------
.env
.env.local
.env.*.local

# --- Logs / runtime sockets -------------------------------------------
*.log
nohup.out
.cache/
.overmind.sock

# --- Cache databases --------------------------------------------------
action_cache.db
data.db
tts_cache.db

# --- Documentation generators -----------------------------------------
site/
# Generated man-page intermediates (committed copies live in inspekt/man/)
build/man/

# --- Inspekt runtime artifacts ----------------------------------------
recording_*.yaml
/recording_*/
inspekt_*.yaml
inspekt/inspekt_*.yaml
test*.yaml
test-*.html

# --- Image output (allowlist real assets) -----------------------------
*.png
!extensions/chrome/icons/*.png
!extensions/firefox/icons/*.png
!docs/**/*.png
!apps/**/*.png

# --- HTML output (allowlist real source files) ------------------------
*.html
!vm/*.html
!vm/pages/*.html
!extensions/**/*.html
!docs/**/*.html
!apps/**/*.html

# --- Other media ------------------------------------------------------
*.pdf
!logos/**/*.pdf
*.webm
*.mp4
*.zip

# --- Temporary / backup files -----------------------------------------
*.bak
*.tmp
*.temp
*_HANDOFF.md
# Engine updaters write restore points next to the vendored libs
inspekt/scripts/vendor/*.backup.js

# --- Broken pip install artifacts (e.g. `=1.0.0` typos) --------------
=*

# --- Claude Code machine-specific state -------------------------------
.claude/projects/
.claude/scheduled_tasks.lock

# --- User-specific config at repo root --------------------------------
/config.json
/sound_choices.json
# Home directory artifact (from `~/` typo)
/~/
