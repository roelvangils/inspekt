<?xml version="1.0" encoding="UTF-8"?>
<!-- Openbox config for split-view mode.
     Windows are undecorated and cannot be resized by user. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>yes</followMouse>
    <focusLast>yes</focusLast>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>no</center>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <popupTime>0</popupTime>
  </desktops>

  <resize>
    <drawContents>no</drawContents>
    <popupShow>Never</popupShow>
    <popupPosition>Center</popupPosition>
  </resize>

  <keyboard></keyboard>

  <!-- Disable all mouse resize/move actions -->
  <mouse>
    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <!-- Disabled: no window dragging -->
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <!-- Disabled: no window resizing -->
      </mousebind>
    </context>
    <context name="Titlebar">
      <!-- No titlebar actions -->
    </context>
    <context name="Top">
      <!-- Disable resize from top edge -->
    </context>
    <context name="Bottom">
      <!-- Disable resize from bottom edge -->
    </context>
    <context name="Left">
      <!-- Disable resize from left edge -->
    </context>
    <context name="Right">
      <!-- Disable resize from right edge -->
    </context>
    <context name="TLCorner">
      <!-- Disable resize from corners -->
    </context>
    <context name="TRCorner">
    </context>
    <context name="BLCorner">
    </context>
    <context name="BRCorner">
    </context>
  </mouse>

  <!-- Apply to all windows: no decorations, no resize -->
  <applications>
    <application class="*">
      <decor>no</decor>
      <focus>yes</focus>
    </application>
  </applications>

</openbox_config>
